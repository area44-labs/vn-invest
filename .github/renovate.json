{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>area44/renovate-config"],
  "packageRules": [
    {
      "matchManagers": ["npm", "pnpm"],
      "groupName": "frontend dependencies",
      "labels": ["frontend", "renovate"]
    },
    {
      "matchManagers": ["pip_requirements", "pep621", "pip_setup"],
      "groupName": "backend dependencies",
      "labels": ["backend", "renovate"]
    }
  ]
}
